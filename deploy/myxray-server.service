[Unit]
Description=MyXray private HTTP/2 transport prototype
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myxray
Group=myxray
ExecStart=/opt/myxray/bin/myxray-server -listen :11322 -admin-listen 127.0.0.1:18122 -cert /etc/myxray/tls/fullchain.pem -key /etc/myxray/tls/privkey.pem -psk-file /etc/myxray/psk -path-file /etc/myxray/path
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
